+            int x = rects[i].x, y = rects[i].y, w = rects[i].w, h = rects[i].h;
+            if (x < 0) { w += x; x = 0; }
+            if (y < 0) { h += y; y = 0; }
+            if (x + w > surface->w) w = surface->w - x;
+            if (y + h > surface->h) h = surface->h - y;
+            if (x + w > inner_w) w = inner_w - x;
+            if (y + h > inner_h) h = inner_h - y;
+            if (w <= 0 || h <= 0) {
+                continue;
