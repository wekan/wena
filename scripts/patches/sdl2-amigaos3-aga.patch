+#if defined(SDL_AMIGAOS3_AGA) && !defined(WARPUP) && defined(SDL_AMIGAOS3_C2P_BPLSIZE_VALUE)
+/* The Kalms c2p writes plane n at Planes[0] + n * BPLSIZE, assembled in:
+ * only a bitmap laid out exactly so may take it. Anything else - another
+ * size, an interleaved bitmap, planes allocated apart - would have it
+ * write over memory that is not the screen's. */
+static int OS3_AGA_PlanesContiguous(const struct BitMap *bm, int width, int height)
+{
+    int i;
+    if (bm->Depth != 8 || (width & 31) != 0 || (int)bm->BytesPerRow * 8 != width ||
+        (int)bm->Rows != height || (long)bm->BytesPerRow * (long)bm->Rows != (long)SDL_AMIGAOS3_C2P_BPLSIZE_VALUE) {
+        return 0;
+    }
+    for (i = 1; i < 8; i++) {
+        if ((const UBYTE *)bm->Planes[i] != (const UBYTE *)bm->Planes[0] + (long)i * (long)SDL_AMIGAOS3_C2P_BPLSIZE_VALUE) {
+            return 0;
+        }
+    }
+    return 1;
+}
+#endif
